# Server
PORT=5000
# Comma-separated list of allowed browser origins (the React dev server by default)
CLIENT_URL=http://localhost:5173

# MongoDB  (local: mongodb://127.0.0.1:27017/cricketpro  |  Atlas: mongodb+srv://USER:PASSWORD@cluster.mongodb.net/cricketpro)
MONGODB_URI=mongodb://127.0.0.1:27017/cricketpro

# JWT - generate a long random string, e.g.:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=8h

# Only used by `npm run seed` to create the demo admin account
SEED_ADMIN_NAME=Demo Admin
SEED_ADMIN_EMAIL=admin@cricketpro.local
SEED_ADMIN_PASSWORD=ChangeMe123
